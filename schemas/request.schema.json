{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/galaxyproject/idc/main/schemas/request.schema.json",
  "title": "IDC reference-data request",
  "description": "One requested reference-data version: data-managers/<data_manager>/<version>.yaml. Generated by scripts/generate_schema.py - do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tool_id": {
      "description": "Version-pinned Tool Shed GUID of the data manager tool: toolshed.g2.bx.psu.edu/repos/<owner>/<repo>/<tool id>/<version>. <tool id> and <version> are the id= and version= of the <tool> tag, not the repository name.",
      "pattern": "^toolshed\\.g2\\.bx\\.psu\\.edu/repos/[^/]+/[^/]+/[^/]+/[^/]+$",
      "title": "Tool Id",
      "type": "string"
    },
    "data_tables": {
      "description": "Data table(s) the data manager writes. The request's directory must be named after one of them.",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Data Tables",
      "type": "array"
    },
    "params": {
      "additionalProperties": true,
      "default": {},
      "description": "The data manager's tool parameters for this build, keyed by <param name=> and nested like the tool form (db_source: {db_type: motus}). Checked against the tool's parameter schema from the Tool Shed.",
      "title": "Params",
      "type": "object"
    },
    "depends_on": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Chained builds: upstream data table name -> the upstream version this build is derived from. A request file must exist at data-managers/<table>/<version>.yaml.",
      "title": "Depends On"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What this data is, for reviewers.",
      "title": "Description"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "DOI of the publication or dataset this data comes from.",
      "title": "Doi"
    }
  },
  "required": [
    "tool_id",
    "data_tables"
  ],
